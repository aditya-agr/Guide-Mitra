# Supabase PostgreSQL connection (Session pooler — IPv4 compatible)
# Get these from the Supabase dashboard: Connect -> Connection String -> Session pooler
#
# Note: JDBC needs the "jdbc:" prefix, and the pooler username is
# "postgres.<project-ref>", not just "postgres".
# Do NOT put username/password inside the URL — JDBC does not support
# the user:password@host syntax; they go in DB_USER / DB_PASS instead.

DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DB_USER=postgres.<project-ref>
DB_PASS=<your-database-password>
